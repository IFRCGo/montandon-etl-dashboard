{
    "name": "montandon-etl-dashboard",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "generate:type": "graphql-codegen --require dotenv/config --config codegen.ts",
        "start": "vite --host 0.0.0.0",
        "prebuild": "pnpm generate:type",
        "build": "vite build",
        "pretypecheck": "pnpm generate:type",
        "typecheck": "tsc",
        "prelint:js": "pnpm generate:type",
        "lint:js": "eslint src",
        "lint:css": "stylelint \"./src/**/*.css\"",
        "lint": "pnpm lint:js && pnpm lint:css",
        "lint:fix": "pnpm lint:js --fix && pnpm lint:css --fix",
        "prelint:unused": "pnpm generate:type",
        "lint:unused": "knip --tags=-knipignore",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "postinstall": "patch-package"
    },
    "dependencies": {
        "@apollo/client": "^3.11.8",
        "@ifrc-go/icons": "^1.3.3",
        "@ifrc-go/ui": "^1.2.1",
        "@togglecorp/fujs": "^2.0.0",
        "@togglecorp/toggle-form": "^2.0.4",
        "graphql": "^16.9.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.11.1",
        "recharts": "^3.0.2"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^5.0.3",
        "@graphql-codegen/client-preset": "^4.3.3",
        "@graphql-typed-document-node/core": "^3.2.0",
        "@julr/vite-plugin-validate-env": "git+https://github.com/toggle-corp/vite-plugin-validate-env#v2.2.0-tc.1",
        "@types/node": "^24.2.0",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.22",
        "@typescript-eslint/eslint-plugin": "^8.14.0",
        "@typescript-eslint/parser": "^8.14.0",
        "@vitejs/plugin-react-swc": "^3.5.0",
        "@vitest/coverage-v8": "^2.1.3",
        "autoprefixer": "^10.4.14",
        "dotenv": "^17.2.1",
        "eslint": "^8.56.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-import-resolver-typescript": "^3.6.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-import-newlines": "^1.4.0",
        "eslint-plugin-jsx-a11y": "^6.10.1",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.13",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "happy-dom": "^18.0.1",
        "knip": "^5.61.3",
        "patch-package": "^8.0.0",
        "postcss": "^8.5.3",
        "postcss-nested": "^7.0.2",
        "postcss-normalize": "^13.0.1",
        "postcss-preset-env": "^10.1.5",
        "stylelint": "^16.17.0",
        "stylelint-config-concentric": "^2.0.2",
        "stylelint-config-recommended": "^15.0.0",
        "stylelint-value-no-unknown-custom-properties": "^6.0.1",
        "typescript": "^5.5.2",
        "typescript-eslint": "8.26.0",
        "vite": "^7.0.6",
        "vite-plugin-checker": "^0.7.0",
        "vite-plugin-compression2": "^1.0.0",
        "vite-plugin-svgr": "^4.2.0",
        "vite-plugin-webfont-dl": "^3.9.4",
        "vite-tsconfig-paths": "^4.2.2",
        "vitest": "^1.3.1"
    },
    "engines": {
        "node": "20",
        "pnpm": "10.6.1"
    },
    "packageManager": "pnpm@10.6.1+sha1.71f9126a20cd3d00fa47c188f956918858180e54"
}
