{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "ignoreExportsUsedInFile": {
        "interface": true,
        "type": true
    },
    "entry": [
        "generated/**/*.ts",
        "src/**/*.test.tsx"
    ],
    "ignoreDependencies": [
        "@vitejs/plugin-react-swc",
        "vite-plugin-checker",
        "vite-plugin-compression2",
        "vite-plugin-webfont-dl",
        "vite-tsconfig-paths"
    ],
    "project": [
        "src/**/*.d.ts",
        "src/**/*.test.tsx",
        "src/**/*.tsx!",
        "src/**/*.ts!"
    ]
}
